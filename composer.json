{
  "name": "gfazioli/add-browser-search",
  "type": "wordpress-plugin",
  "description": "Publish your WordPress search as an OpenSearch description, so browsers can add it as a search engine.",
  "keywords": [
    "wordpress",
    "opensearch",
    "search"
  ],
  "homepage": "https://wordpress.org/plugins/add-browser-search/",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "Giovambattista Fazioli",
      "email": "giovambattista.fazioli@gmail.com",
      "homepage": "https://undolog.com"
    }
  ],
  "require": {
    "php": ">=8.1",
    "wpbones/wpbones": "^3.4.0"
  },
  "autoload": {
    "psr-4": {
      "AddBrowserSearch\\": "plugin/"
    },
    "files": [
      "functions.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "AddBrowserSearch\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11.0",
    "brain/monkey": "^2.7"
  },
  "scripts": {
    "post-autoload-dump": [
      "php -r \"copy('vendor/wpbones/wpbones/src/Console/bin/bones', 'bones');\"",
      "php bones rename --update",
      "php -r \"file_put_contents('vendor/wpbones/wpbones/src/Foundation/Plugin.php', str_replace('/add-browser-search.php', '/wp-abs.php', file_get_contents('vendor/wpbones/wpbones/src/Foundation/Plugin.php')));\""
    ],
    "test": "phpunit"
  },
  "scripts-descriptions": {
    "test": "Run the unit suite."
  }
}
